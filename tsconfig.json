{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@utils": ["./packages/utils/src"]
    },
    "types": ["node"]
  },
  "include": [
    "eslint.config.mts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "src/**/*.ts",
  ]
}
